{
  "name": "@aim-lab/dsh-brand",
  "version": "0.1.0",
  "description": "AIM-Lab 的 DeepSeek Harness 品牌插件",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "README.md"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node scripts/test-client.mjs",
    "pack": "node scripts/check.mjs && node scripts/test-client.mjs && node scripts/pack.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
